<%- include('partials/head', { title, metaDescription }) %>
<%- include('partials/header') %>

<main class="section" style="padding-top: 5rem; padding-bottom: 6rem;">
  <div class="container container-narrow">
    <div class="status-card">
      <div class="status-icon-large status-icon-pending">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
      </div>

      <span class="eyebrow" style="color: #FFB400;">VERIFICATION REQUIRED</span>
      <h1 style="font-size: 2rem; margin-top: 0.5rem; margin-bottom: 1rem;">
        Confirmation Access Restricted
      </h1>
      <p class="body-text" style="margin-bottom: 2rem;">
        Access to the confirmed registration details and private community is restricted to attendees with verified payments.
      </p>

      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="/checkout" class="btn btn-primary">
          Register for Masterclass (₹199)
        </a>
        <a href="/contact" class="btn btn-secondary">
          Contact Support Desk
        </a>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
