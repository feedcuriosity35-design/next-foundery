<%- include('partials/head', { title, metaDescription }) %>
<%- include('partials/header') %>

<main>
  <!-- Hero Banner -->
  <section class="section section-hero" style="padding-top: 5rem; padding-bottom: 4rem;">
    <div class="container container-narrow" style="text-align: center;">
      <span class="eyebrow">ABOUT NEXT FOUNDERY</span>
      <h1 class="display-title" style="margin-bottom: 1.5rem;">
        Businesses Built Better.
      </h1>
      <p class="lead-text" style="max-width: 680px; margin: 0 auto 2rem;">
        Next Foundery is an entrepreneurship-building brand created to help founders, professionals, and aspiring business creators replace guesswork with clarity, validation, and structured strategy.
      </p>
      <a href="/checkout" class="btn btn-primary">
        Join the Blueprint Masterclass · ₹199
      </a>
    </div>
  </section>

  <!-- Mission & Approach -->
  <section class="section section-dark">
    <div class="container">
      <div class="about-grid">
        <div>
          <span class="eyebrow">OUR PHILOSOPHY</span>
          <h2 class="section-title">We Help You Think Beyond the Idea.</h2>
          <p class="body-text" style="margin-bottom: 1.25rem;">
            Every successful enterprise begins with an idea, but an idea alone is never sufficient. Too many promising entrepreneurs invest money, time, and enthusiasm without first answering the foundational questions that determine longevity.
          </p>
          <p class="body-text" style="margin-bottom: 1.25rem;">
            At Next Foundery, we believe in building businesses on solid foundations. We focus on rigorous customer discovery, realistic market evaluation, and practical unit economics before large commitments are made.
          </p>
          <p class="body-text">
            Our mission is to democratize actionable business knowledge through accessible programs like our <strong>Business Growth Blueprint Masterclass (₹199)</strong>, giving aspiring founders the tools to make grounded decisions.
          </p>
        </div>
        <div>
          <div class="about-image-wrapper">
            <img src="/images/about-foundery.jpg" alt="Venture Strategy and Collaborative Analysis" width="600" height="400" loading="lazy">
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Focus Areas (5 Pillars) -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">OUR SYSTEMIC FOCUS</span>
        <h2 class="section-title">The Five Foundations of Better Business</h2>
        <p class="body-text" style="max-width: 600px; margin: 0 auto;">
          The principles and methodologies that guide every program and session we design.
        </p>
      </div>

      <div class="explore-grid">
        <div class="explore-card">
          <span class="explore-card-number">01</span>
          <h3 class="explore-card-title">Business Research &amp; Validation</h3>
          <p class="explore-card-desc">
            Techniques to test assumptions rapidly, study market sizes, analyze existing alternatives, and evaluate viability with minimal upfront capital.
          </p>
        </div>

        <div class="explore-card">
          <span class="explore-card-number">02</span>
          <h3 class="explore-card-title">Strategy &amp; Positioning</h3>
          <p class="explore-card-desc">
            Carving a defensible niche in crowded markets, articulating value propositions clearly, and avoiding race-to-the-bottom pricing traps.
          </p>
        </div>

        <div class="explore-card">
          <span class="explore-card-number">03</span>
          <h3 class="explore-card-title">Marketing &amp; Growth Planning</h3>
          <p class="explore-card-desc">
            Understanding organic and paid customer acquisition channels, sustainable retention mechanisms, and realistic funnel economics.
          </p>
        </div>

        <div class="explore-card">
          <span class="explore-card-number">04</span>
          <h3 class="explore-card-title">Customer &amp; Market Understanding</h3>
          <p class="explore-card-desc">
            Conducting non-leading customer interviews, discovering true willingness to pay, and mapping actual pain points vs hypothetical features.
          </p>
        </div>

        <div class="explore-card">
          <span class="explore-card-number">05</span>
          <h3 class="explore-card-title">Execution &amp; Development</h3>
          <p class="explore-card-desc">
            Translating strategic insights into weekly operational milestones, pilot rollouts, legal considerations, and steady milestone execution.
          </p>
        </div>

        <div class="explore-card" style="background: rgba(183, 245, 42, 0.05); border-color: rgba(183, 245, 42, 0.3);">
          <span class="explore-card-number" style="background: var(--color-lime); color: var(--color-forest);">ENROLL</span>
          <h3 class="explore-card-title" style="color: var(--color-lime);">Experience the Masterclass</h3>
          <p class="explore-card-desc" style="color: var(--color-offwhite);">
            Take the first step with our Business Growth Blueprint Masterclass. Practical direction and recordings for ₹199.
          </p>
          <div style="margin-top: auto; padding-top: 1rem;">
            <a href="/checkout" class="btn btn-primary btn-sm btn-block">Claim Seat · ₹199</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="section section-dark">
    <div class="container container-narrow">
      <div class="section-header">
        <span class="eyebrow">INTEGRITY &amp; PRAGMATISM</span>
        <h2 class="section-title">What We Stand For</h2>
      </div>

      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <div class="problem-card">
          <h3 class="problem-card-title">No Hype, No Guaranteed Outcomes</h3>
          <p class="problem-card-text">
            Entrepreneurship carries inherent risks and depends upon personal execution, market conditions, and perseverance. We provide structured guidance and frameworks, never false promises or fabricated shortcuts.
          </p>
        </div>

        <div class="problem-card">
          <h3 class="problem-card-title">Transparent &amp; Accessible</h3>
          <p class="problem-card-text">
            Foundational entrepreneurship guidance should not be locked behind exorbitant fee structures. We keep our introductory masterclasses priced at just ₹199 to ensure genuine founders can participate.
          </p>
        </div>

        <div class="problem-card">
          <h3 class="problem-card-title">Interactive &amp; Context-Driven</h3>
          <p class="problem-card-text">
            Real questions deserve real discussions. Our sessions are interactive, leaving room for participants to raise their specific doubts and explore practical angles with peers.
          </p>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
