            <div>
              <div class="hero-floating-price">₹199</div>
              <div class="hero-floating-meta">All-inclusive access &amp; recordings</div>
            </div>
            <a href="/checkout" class="btn btn-primary btn-sm" style="padding: 0.5rem 1rem;">Join Now</a>
          </div>
        </div>
      </div>
    </div>
