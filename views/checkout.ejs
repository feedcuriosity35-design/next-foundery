<%- include('partials/head', { title, metaDescription }) %>

<header class="navbar" style="border-bottom: 1px solid var(--color-border-subtle);">
  <div class="container navbar-inner" style="justify-content: space-between;">
    <a href="/" class="brand-link">
      <img src="/nextfoundery-logo.png" alt="Next Foundery Logo" class="brand-logo-img">
      <div class="brand-text-container">
        <span class="brand-name">Next Foundery</span>
        <span class="brand-tagline">Businesses Built Better</span>
      </div>
    </a>
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <span style="font-size: 0.85rem; color: var(--color-muted-light);">Distraction-Free Checkout</span>
      <span style="display: inline-block; width: 6px; height: 6px; background-color: var(--color-green-support); border-radius: 50%;"></span>
    </div>
  </div>
</header>

<main class="section" style="padding-top: 3rem;">
  <div class="container">
    <div class="checkout-layout">
      <!-- Left Column: Registration Details & UPI Payment -->
      <div class="checkout-card">
        <div style="margin-bottom: 2rem;">
          <span class="eyebrow">STEP 1 OF 2 · ATTENDEE REGISTRATION</span>
          <h1 style="font-size: 2rem; margin-top: 0.5rem; margin-bottom: 0.5rem;">
            Reserve Your Masterclass Seat
          </h1>
          <p class="body-text">
            Enter your details below to receive your session joining credentials and access instructions.
          </p>
        </div>

        <form id="checkoutForm" novalidate>
          <!-- Full Name -->
          <div class="form-group">
            <label for="attendeeName" class="form-label">Full Name *</label>
            <input 
              type="text" 
              id="attendeeName" 
              name="name" 
              class="form-input" 
              placeholder="e.g. Rahul Sharma" 
              value="<%= initialData ? initialData.name : '' %>"
              required
            >
            <div class="form-error" id="nameError">Please enter your full name (minimum 2 characters).</div>
          </div>

          <!-- Email Address -->
          <div class="form-group">
            <label for="attendeeEmail" class="form-label">Email Address *</label>
            <input 
              type="email" 
              id="attendeeEmail" 
              name="email" 
              class="form-input" 
              placeholder="name@example.com" 
              value="<%= initialData ? initialData.email : '' %>"
              required
            >
            <div class="form-error" id="emailError">Please enter a valid email address.</div>
            <div style="font-size: 0.8rem; color: var(--color-muted-light); margin-top: 0.35rem;">
              Session joining links and recording access will be delivered to this email.
            </div>
          </div>

          <!-- Mobile Number -->
          <div class="form-group">
            <label for="attendeePhone" class="form-label">Mobile Number (WhatsApp Preferred) *</label>
            <div style="position: relative; display: flex;">
              <span style="display: flex; align-items: center; background: rgba(255,255,255,0.06); border: 1px solid var(--color-border-subtle); border-right: none; padding: 0 1rem; border-top-left-radius: var(--radius-sm); border-bottom-left-radius: var(--radius-sm); color: var(--color-white); font-weight: 600;">+91</span>
              <input 
                type="tel" 
                id="attendeePhone" 
                name="phone" 
                class="form-input" 
                style="border-top-left-radius: 0; border-bottom-left-radius: 0;"
                placeholder="9876543210" 
                value="<%= initialData ? initialData.phone : '' %>"
                maxlength="10"
                required
              >
            </div>
            <div class="form-error" id="phoneError">Please enter a valid 10-digit mobile number.</div>
          </div>

          <!-- Optional Focus/Interest -->
          <div class="form-group">
            <label for="attendeeInterest" class="form-label">Business Interest / Idea (Optional)</label>
            <input 
              type="text" 
              id="attendeeInterest" 
              name="interest" 
              class="form-input" 
              placeholder="e.g. D2C brand, Tech SaaS, Consulting, Local Services" 
              value="<%= initialData ? initialData.interest : '' %>"
            >
            <div style="font-size: 0.8rem; color: var(--color-muted-light); margin-top: 0.35rem;">
              Helps us tailor open discussion topics to participant interests.
            </div>
          </div>

          <!-- Payment Method: Cashfree & Instant UPI -->
          <div class="payment-box">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" color="#B7F52A"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <strong style="color: var(--color-white); font-size: 1.05rem;">Cashfree Payment Gateway</strong>
              </div>
              <span style="background: rgba(37, 184, 74, 0.12); color: var(--color-green-support); padding: 0.25rem 0.6rem; border-radius: var(--radius-full); font-size: 0.78rem; font-weight: 700;">
                100% Secure &amp; Verified
              </span>
            </div>

            <p class="body-text" style="font-size: 0.92rem; margin-bottom: 1rem;">
              Pay smoothly with Cashfree using your preferred UPI app (Google Pay, PhonePe, Paytm, CRED), Debit/Credit Cards, NetBanking, or instant QR.
            </p>

            <div class="upi-app-badges">
              <span class="upi-app-badge">Cashfree PG</span>
              <span class="upi-app-badge">Google Pay</span>
              <span class="upi-app-badge">PhonePe</span>
              <span class="upi-app-badge">Paytm</span>
              <span class="upi-app-badge">Cards &amp; UPI</span>
            </div>
          </div>

          <!-- Status / Error Messages Container -->
          <div id="checkoutFeedback" style="margin-top: 1.5rem; display: none;"></div>

          <!-- Submit Button -->
          <div style="margin-top: 2rem;">
            <button type="submit" class="btn btn-primary btn-block" id="payButton" style="font-size: 1.15rem; padding: 1.1rem;">
              <span id="buttonText">Proceed to Pay · ₹199</span>
              <span id="buttonSpinner" style="display: none;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="animation: spin 1s linear infinite;"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle><path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"></path></svg>
              </span>
            </button>
          </div>

          <div style="margin-top: 1.25rem; text-align: center; font-size: 0.85rem; color: var(--color-muted-light);">
            By continuing, you agree to our 
            <a href="/terms" target="_blank" style="color: var(--color-white); text-decoration: underline;">Terms</a>, 
            <a href="/privacy" target="_blank" style="color: var(--color-white); text-decoration: underline;">Privacy Policy</a>, and 
            <a href="/refund-policy" target="_blank" style="color: var(--color-white); text-decoration: underline;">Refund Policy</a>.
          </div>
        </form>

        <!-- Next Foundery Interactive Payment Gateway Modal (Overlay Dialog) -->
        <div id="paymentGatewayModal" class="payment-gateway-overlay" style="display: none;">
          <div class="payment-gateway-dialog">
            <!-- Modal Header -->
            <div class="gateway-header">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <span style="display: inline-block; width: 8px; height: 8px; background: var(--color-lime); border-radius: 50%; box-shadow: 0 0 10px var(--color-lime);"></span>
                  <span style="font-size: 0.78rem; font-weight: 700; color: var(--color-lime); text-transform: uppercase; letter-spacing: 0.05em;">SECURE PAYMENT GATEWAY</span>
                </div>
                <button type="button" id="closeGatewayBtn" class="gateway-close-btn" aria-label="Close">&times;</button>
              </div>
              <div style="display: flex; align-items: baseline; justify-content: space-between;">
                <div>
                  <h3 style="color: var(--color-white); font-size: 1.35rem; margin: 0;">Complete Payment</h3>
                  <div style="font-size: 0.85rem; color: var(--color-muted-light); margin-top: 0.15rem;" id="gatewayAttendeeSummary">Masterclass Registration</div>
                </div>
                <div style="text-align: right;">
                  <div style="font-size: 1.75rem; font-weight: 800; color: var(--color-lime); font-family: var(--font-heading);">₹199</div>
                  <div style="font-size: 0.75rem; color: var(--color-muted-light);">All inclusive</div>
                </div>
              </div>
            </div>

            <!-- Instant UPI Apps Row -->
            <div style="padding: 1.25rem 1.5rem; background: rgba(255,255,255,0.02); border-bottom: 1px solid var(--color-border-subtle);">
              <div style="font-size: 0.82rem; font-weight: 700; color: var(--color-white); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.75rem;">
                Pay Directly via UPI App
              </div>
              <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.65rem;">
                <a id="gpayAppBtn" href="#" class="gateway-app-btn">
                  <span class="app-icon" style="background: #FFFFFF; color: #4285F4; font-weight: 800; font-size: 0.85rem; padding: 2px 6px; border-radius: 4px;">G</span>
                  <span>Google Pay</span>
                </a>
                <a id="phonepeAppBtn" href="#" class="gateway-app-btn">
                  <span class="app-icon" style="background: #5f259f; color: #fff; font-weight: 800; font-size: 0.85rem; padding: 2px 6px; border-radius: 4px;">Pe</span>
                  <span>PhonePe</span>
                </a>
                <a id="paytmAppBtn" href="#" class="gateway-app-btn">
                  <span class="app-icon" style="background: #00baf2; color: #fff; font-weight: 800; font-size: 0.85rem; padding: 2px 6px; border-radius: 4px;">P</span>
                  <span>Paytm</span>
                </a>
              </div>
              <div style="margin-top: 0.65rem;">
                <a id="upiIntentBtn" href="#" class="btn btn-primary btn-block btn-sm" style="text-align: center;">
                  Open Any UPI App (BHIM, CRED, Bank UPI) &rarr;
                </a>
              </div>
            </div>

            <!-- QR Code Section -->
            <div style="padding: 1.5rem; text-align: center;">
              <div style="font-size: 0.8rem; font-weight: 700; color: var(--color-muted-light); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.75rem;">
                OR SCAN &amp; PAY WITH ANY QR SCANNER
              </div>

              <div style="background: #FFFFFF; border-radius: 16px; padding: 0.85rem; display: inline-block; box-shadow: 0 4px 20px rgba(0,0,0,0.3); margin-bottom: 0.75rem;">
                <img id="gatewayQrImage" src="/images/official-upi-qr.png" alt="Scan to pay ₹199" style="width: 200px; height: 200px; display: block; object-fit: contain;">
              </div>

              <div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-bottom: 1.25rem;">
                <span style="font-size: 0.88rem; color: var(--color-offwhite); font-family: monospace;" id="gatewayUpiVpa"><%= config.payment.upiVpa %></span>
                <button type="button" id="copyVpaBtn" class="btn btn-sm btn-secondary" style="padding: 0.25rem 0.65rem; font-size: 0.78rem;">Copy</button>
              </div>

              <!-- UTR submission form -->
              <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); padding: 1rem; text-align: left;">
                <div style="font-size: 0.85rem; font-weight: 600; color: var(--color-white); margin-bottom: 0.35rem;">
                  Completed Payment? Submit 12-digit UTR
                </div>
                <div style="font-size: 0.78rem; color: var(--color-muted-light); margin-bottom: 0.75rem;">
                  Enter the 12-digit UPI reference / UTR number from your payment app to instantly confirm your seat.
                </div>
                <form id="gatewayUtrForm" style="display: flex; gap: 0.5rem;">
                  <input type="text" id="gatewayUtrInput" class="form-input" style="flex: 1;" placeholder="e.g. 429381729012" maxlength="20" required>
                  <button type="submit" class="btn btn-primary btn-sm" id="gatewaySubmitUtrBtn">Confirm Seat</button>
                </form>
                <div class="form-error" id="gatewayUtrError" style="margin-top: 0.4rem;">Please enter a valid 12-digit UTR.</div>
              </div>

              <!-- Sandbox Testing Simulator -->
              <div style="margin-top: 1rem; padding: 0.75rem; background: rgba(183, 245, 42, 0.05); border: 1px dashed rgba(183, 245, 42, 0.3); border-radius: var(--radius-sm); font-size: 0.8rem; display: flex; align-items: center; justify-content: space-between;">
                <span style="color: var(--color-muted-light);">Test Verification Mode</span>
                <button type="button" class="btn btn-sm btn-secondary" id="simPaySuccessBtn" style="padding: 0.25rem 0.65rem; font-size: 0.75rem;">
                  Instant Test Approve
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Order Summary (Fixed ₹199) -->
      <aside>
        <div class="order-summary-card">
          <div class="order-summary-header">
            <span class="eyebrow" style="font-size: 0.75rem; margin-bottom: 0.5rem;">ORDER SUMMARY</span>
            <h2 style="font-size: 1.35rem; color: var(--color-white); margin-bottom: 0.5rem;">
              Business Growth Blueprint Masterclass
            </h2>
            <p class="body-text" style="font-size: 0.9rem;">
              Practical entrepreneurship guidance, open discussion, and comprehensive session recordings.
            </p>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.92rem; margin-bottom: 1.5rem;">
            <div style="display: flex; align-items: center; gap: 0.65rem; color: var(--color-offwhite);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" color="#B7F52A"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Interactive Live Masterclass</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.65rem; color: var(--color-offwhite);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" color="#B7F52A"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Idea-Focused Guidance &amp; Open Q&amp;A</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.65rem; color: var(--color-offwhite); font-weight: 600;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" color="#B7F52A"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Session Recordings Included</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.65rem; color: var(--color-offwhite);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" color="#B7F52A"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Verified WhatsApp Community Access</span>
            </div>
          </div>

          <div class="order-price-row">
            <div>
              <div style="font-size: 0.9rem; color: var(--color-muted-light);">Total Payable</div>
              <div style="font-size: 0.78rem; color: var(--color-green-support);">Inclusive of all taxes</div>
            </div>
            <div class="order-total-price">₹199</div>
          </div>

          <!-- Trust & Security Signals -->
          <div style="margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border-subtle); display: flex; flex-direction: column; gap: 0.75rem;">
            <div style="display: flex; align-items: center; gap: 0.65rem; font-size: 0.82rem; color: var(--color-muted-light);">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" color="#25B84A"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>256-Bit Cryptographic Payment Verification</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.65rem; font-size: 0.82rem; color: var(--color-muted-light);">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" color="#25B84A"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
              <span>Instant Confirmation upon Payment</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.65rem; font-size: 0.82rem; color: var(--color-muted-light);">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" color="#25B84A"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
              <span>Private WhatsApp link delivered post-verification</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</main>

<style>
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Payment Gateway Overlay Dialog */
.payment-gateway-overlay {
  position: fixed;
  inset: 0;
  background: rgba(5, 12, 7, 0.88);
  backdrop-filter: blur(10px);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  overflow-y: auto;
}

.payment-gateway-dialog {
  background: var(--color-forest);
  border: 1px solid var(--color-border-subtle);
  border-radius: var(--radius-lg);
  max-width: 440px;
  width: 100%;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
  overflow: hidden;
  animation: modalSlideIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes modalSlideIn {
  from { opacity: 0; transform: scale(0.95) translateY(10px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.gateway-header {
  padding: 1.25rem 1.5rem;
  background: rgba(255, 255, 255, 0.04);
  border-bottom: 1px solid var(--color-border-subtle);
}

.gateway-close-btn {
  background: transparent;
  border: none;
  color: var(--color-muted-light);
  font-size: 1.75rem;
  line-height: 1;
  cursor: pointer;
  padding: 0;
}

.gateway-close-btn:hover {
  color: var(--color-white);
}

.gateway-app-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  padding: 0.75rem 0.5rem;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--color-border-subtle);
  border-radius: var(--radius-sm);
  color: var(--color-white);
  text-decoration: none;
  font-size: 0.8rem;
  font-weight: 600;
  transition: all 0.2s ease;
}

.gateway-app-btn:hover {
  background: rgba(183, 245, 42, 0.08);
  border-color: var(--color-lime);
}
</style>

<%- include('partials/footer') %>

<!-- Cashfree JS SDK v3 -->
<script src="https://sdk.cashfree.com/js/v3/cashfree.js"></script>

<!-- Checkout Controller Script -->
<script src="/js/checkout.js"></script>
