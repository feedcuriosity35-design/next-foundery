<%- include('partials/head', { title, metaDescription }) %>
<%- include('partials/header') %>

<main class="section" style="padding-top: 5rem; padding-bottom: 6rem;">
  <div class="container container-narrow">
    <div class="status-card">
      <span class="eyebrow" style="color: #FF5A5F;">ERROR 500</span>
      <h1 style="font-size: 2.2rem; margin-top: 0.5rem; margin-bottom: 1rem;">Server Error</h1>
      <p class="body-text" style="margin-bottom: 2rem;">
        An unexpected error occurred while processing your request. Please try refreshing or reach out to our support desk.
      </p>
      <div style="display: flex; justify-content: center; gap: 1rem;">
        <a href="/" class="btn btn-primary">Return Home</a>
        <a href="/contact" class="btn btn-secondary">Contact Support</a>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
