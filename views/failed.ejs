<%- include('partials/head', { title, metaDescription }) %>

<header class="navbar" style="border-bottom: 1px solid var(--color-border-subtle);">
  <div class="container navbar-inner" style="justify-content: space-between;">
    <a href="/" class="brand-link">
      <img src="/nextfoundery-logo.png" alt="Next Foundery Logo" class="brand-logo-img">
      <div class="brand-text-container">
        <span class="brand-name">Next Foundery</span>
        <span class="brand-tagline">Businesses Built Better</span>
      </div>
    </a>
    <span style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(255, 90, 95, 0.15); border: 1px solid #FF5A5F; color: #FF5A5F; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.85rem; font-weight: 700;">
      Payment Not Completed
    </span>
  </div>
</header>

<main class="section" style="padding-top: 3.5rem; padding-bottom: 5rem;">
  <div class="container container-narrow">
    <div class="status-card">
      <!-- Failed Icon -->
      <div class="status-icon-large status-icon-failed">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </div>

      <span class="eyebrow" style="color: #FF5A5F;">PAYMENT UNCONFIRMED</span>
      <h1 style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); margin-top: 0.5rem; margin-bottom: 0.75rem;">
        Payment Was Not Completed
      </h1>
      <p class="body-text" style="font-size: 1.05rem; max-width: 540px; margin: 0 auto 2rem;">
        Your transaction was cancelled, interrupted, or declined by the bank. No worry — your registration details have been saved so you can retry easily.
      </p>

      <% if (order) { %>
      <table class="order-details-table">
        <tbody>
          <tr>
            <td class="order-details-label">Order Reference</td>
            <td class="order-details-value" style="font-family: monospace;"><%= order.order_id %></td>
          </tr>
          <tr>
            <td class="order-details-label">Attendee</td>
            <td class="order-details-value"><%= order.name %></td>
          </tr>
          <tr>
            <td class="order-details-label">Amount</td>
            <td class="order-details-value">₹199 INR</td>
          </tr>
          <tr>
            <td class="order-details-label">Status</td>
            <td class="order-details-value" style="color: #FF5A5F;">Incomplete / Cancelled</td>
          </tr>
        </tbody>
      </table>
      <% } %>

      <!-- Helpful Advice -->
      <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-md); padding: 1.5rem; margin-bottom: 2rem; text-align: left;">
        <h4 style="font-size: 1rem; color: var(--color-white); margin-bottom: 0.5rem;">Common Reasons for Failed UPI Transactions:</h4>
        <ul style="font-size: 0.9rem; color: var(--color-muted-light); margin-left: 1.25rem; display: flex; flex-direction: column; gap: 0.35rem;">
          <li>Temporary bank server or UPI network latency</li>
          <li>UPI PIN entered incorrectly or timed out in UPI app</li>
          <li>Payment window closed before completing authorization</li>
        </ul>
      </div>

      <!-- Action Buttons -->
      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="/checkout<% if (order) { %>?retry_order=<%= encodeURIComponent(order.order_id) %><% } %>" class="btn btn-primary" id="retryPaymentBtn">
          Retry UPI Payment · ₹199
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
        </a>
        <a href="/contact" class="btn btn-secondary">
          Contact Support
        </a>
      </div>

      <div style="margin-top: 2.5rem; font-size: 0.88rem; color: var(--color-muted-light);">
        If your bank account was debited, please email your transaction reference to 
        <a href="mailto:<%= config.support.email %>" style="color: var(--color-lime); text-decoration: underline;"><%= config.support.email %></a> 
        so we can verify and confirm your seat manually.
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
