# ==============================================================================
# Next Foundery — Environment Configuration Template
# Brand: Businesses Built Better
# ==============================================================================

PORT=3000
NODE_ENV=development

# Cashfree Payment Gateway Credentials (Primary)
# Get credentials from: https://merchant.cashfree.com/merchants/developers/api-keys
# Set CASHFREE_ENV to "SANDBOX" for testing or "PRODUCTION" for live transactions
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2023-08-01

# Razorpay UPI Gateway Credentials (Fallback)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret_key_here
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_here

# Official Direct UPI Details & Official QR Code
UPI_VPA=9205828721@ptsbi
UPI_PAYEE_NAME="Aarushi Bajpai (Next Foundery)"
OFFICIAL_QR_IMAGE="/images/official-upi-qr.png"

# Masterclass Configuration (Fixed at Rs 199)
MASTERCLASS_TITLE="Business Growth Blueprint Masterclass"
MASTERCLASS_PRICE=199
MASTERCLASS_CURRENCY=INR

# Session Logistics
SESSION_DATE="Saturday, 25 October 2026"
SESSION_TIME="11:00 AM – 1:00 PM IST"
SESSION_FORMAT="Live Interactive Online Session (Zoom)"
SESSION_JOIN_INFO="Official joining link and access instructions will be sent to your registered email and WhatsApp 24 hours before the session."
RECORDING_ACCESS_INFO="Session recordings will be uploaded and shared with registered participants within 24 hours after session completion."

# Official Private WhatsApp Community (Sent ONLY after payment verification)
WHATSAPP_GROUP_INVITE_URL="https://chat.whatsapp.com/FCWNqLKr9Vo3Y94r5m2STl?s=cl&p=a&mlu=4&ilr=4"

# Business Contact & Support
SUPPORT_EMAIL=nextfoundery@gmail.com
SUPPORT_HOURS="Monday – Saturday, 10:00 AM – 6:00 PM IST"

# Gmail SMTP — Contact Form Email Delivery (Nodemailer)
# 1. Enable 2-Step Verification on nextfoundery@gmail.com
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail" > "Other (Next Foundery)"
# 4. Paste the generated 16-character password below (no spaces)
GMAIL_USER=nextfoundery@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# Internal Admin PIN
ADMIN_ACCESS_PIN=admin199
